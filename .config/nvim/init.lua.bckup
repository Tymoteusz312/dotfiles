-- Aktywacja motywu Visual Studio
vim.g.everforest_background = 'medium'

vim.g.everforest_enable_italic_comments = 1

vim.cmd[[colorscheme everforest]]

local capabilities = require('cmp_nvim_lsp').default_capabilities()

vim.lsp.config('clangd', {
    cmd = {
        "clangd",
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--offset-encoding=utf-16",
    },
    capabilities = capabilities, -- Poprawiona literówka
    on_attach = function(client, bufnr)
        -- Poprawiona literówka: inlayHintProvider
        if client.server_capabilities.inlayHintProvider then
            vim.lsp.inlay_hint.enable(true, { bufnr = bufnr })
        end
    end,
    filetypes = { "c", "cpp", "objc", "objcpp", "cuda", "proto" },
})

vim.lsp.config('zls', {
    cmd = {'zls'},
    filetypes = {'zig', 'zir'},
    root_makers = {'build.zig', 'zls.json', '.git'},
    settings = {
        zls = {
            enable_autofix = true,
            warn_style = true,
        }
    }
})

vim.lsp.config("rust-analyzer", {
    cmd = { vim.fn.stdpath("data") .. "/mason/bin/rust-analyzer"},
    filetypes = {'rs', 'rust'},
    root_makers = {'Cargo.toml', ".git"},
    capabilities = capabilities,
    settings = {
        ["rust-analyzer"] = {
            checkOnSave = {command = "clippy"},
        },
    },
})

-- Uruchomienie serwera
vim.lsp.enable('clangd')
vim.lsp.enable('zls')
vim.lsp.enable('rust-analyzer');

vim.lsp.inlay_hint.enable(true)

local cmp = require('cmp')


local cmp = require('cmp')
local luasnip = require('luasnip')

cmp.setup({
    snippet = {
        expand = function(args)
            luasnip.lsp_expand(args.body)
        end,
    },
    mapping = cmp.mapping.preset.insert({
        ['<C-b>'] = cmp.mapping.scroll_docs(-4),
        ['<C-f>'] = cmp.mapping.scroll_docs(4),
        ['<Tab>'] = cmp.mapping(function(fallback)
            if cmp.visible() then
                cmp.confirm({ select = true })
            elseif luasnip.expand_or_jumpable() then
                luasnip.expand_or_jump()
            else
                fallback()
            end
        end, { 'i', 's' }),
        ['<S-Tab>'] = cmp.mapping(function(fallback) -- Dodano brakujące < >
            if cmp.visible() then
                cmp.select_prev_item()
            elseif luasnip.jumpable(-1) then
                luasnip.jump(-1)
            else
                fallback()
            end
        end, { 'i', 's' }),
    }), -- Koniec mappingów
    sources = cmp.config.sources({
        { name = 'nvim_lsp' }, -- Poprawione: nvim_lsp (z podkreślnikiem)
        { name = 'luasnip' },
    }, {
        { name = 'buffer' },
        { name = 'path' },
    })
}) 


vim.diagnostic.config({
    virtual_text = {
        prefix = '●', -- Znak przed błędem
        spacing = 4,   -- Odstęp od kodu
    },
    update_in_insert = true, -- Sprawdzaj błędy nawet podczas pisania (nie czekaj na wyjście z trybu Insert)
    underline = true,        -- Podkreślaj błędy w kodzie
    severity_sort = true,    -- Najpierw pokazuj najważniejsze błędy (Error przed Warning)
})

-- Automatyczne okienko z błędem po krótkiej chwili bezruchu
vim.api.nvim_create_autocmd("CursorHold", {
    callback = function()
        vim.diagnostic.open_float(nil, { focusable = false })
    end,
})

-- Ustaw czas oczekiwania na 300ms (domyślnie jest to 4 sekundy, co jest za wolne)
vim.opt.updatetime = 300

