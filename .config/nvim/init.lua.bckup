require("oil").setup({
      -- Czy Oil ma być domyślnym eksploratorem (zamiast netrw)
      default_file_explorer = true,
      
      -- Kolumny wyświetlane w widoku plików
      columns = {
        "icon",
        -- "permissions",
        -- "size",
        -- "mtime",
      },
      
      -- Konfiguracja okna pływającego (używane przy require("oil").toggle_float())
      float = {
        padding = 2,
        max_width = 0,
        max_height = 0,
        border = "rounded", -- "double", "single", "shadow"
      },

      -- Opcje widoku
      view_options = {
        -- Pokaż ukryte pliki (dotfiles) domyślnie
        show_hidden = true,
        -- Możesz zdefiniować, jakie pliki mają być pomijane
        is_always_hidden = function(name, bufnr)
          return name == ".." or name == ".git"
        end,
      },

      -- Skróty klawiszowe wewnątrz okna Oil
      keymaps = {
        ["g?"] = "actions.show_help",
        ["<CR>"] = "actions.select",
        ["<C-s>"] = "actions.select_vsplit", -- Otwórz w pionowym podziale
        ["<C-h>"] = "actions.select_split",  -- Otwórz w poziomym podziale
        ["<C-p>"] = "actions.preview",       -- Podgląd pliku w okienku
        ["<C-c>"] = "actions.close",
        ["-"] = "actions.parent",            -- Przejdź folder wyżej
        ["_"] = "actions.open_cwd",          -- Otwórz folder roboczy projektu
        ["gs"] = "actions.change_sort",      -- Zmień sposób sortowania
        ["gx"] = "actions.open_external",    -- Otwórz plik w systemowym programie
        ["g."] = "actions.toggle_hidden",    -- Przełącz widoczność ukrytych plików
      },
    })

    -- Twoje skróty klawiszowe do wywoływania Oil
    vim.keymap.set("n", "-", "<CMD>Oil<CR>", { desc = "Otwórz folder nadrzędny" })
    vim.keymap.set("n", "<leader>e", function() require("oil").toggle_float() end, { desc = "Eksplorator plików (pływający)" })

